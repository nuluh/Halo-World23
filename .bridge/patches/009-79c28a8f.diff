+// openVFIFE public API: supported frame and link elements
+#pragma once
+
+#include <openvfife/element/base.hpp>
+
+namespace openvfife {
+class Link2D:public StructElement
+{
+    protected:
+        const StdArray6d* posi_;
+        const StdArray6d* posj_;

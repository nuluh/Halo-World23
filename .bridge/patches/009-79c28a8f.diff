+               const BaseSection& sect);
+        ~Link2D() override = default;
+        virtual void outputForce(std::fstream &fout);
+};
+
+class Beam2D:public StructElement
+{
+    /* Elastic 2D Beam element, which can count on geometric nonlinearity
+    * Only Elastic materials are supported, if an plasticity material is given
+    * only the elastic state will be used. Obviously this element do not
+    * support the failure of element.
+    *
+    * Formulation (VFIFE co-rotational, x-y plane, rotation about z):
+    * each step the rigid-body motion between the last recorded configuration
+    * and the current one is removed; the remaining deformation increments
+    * [d(elongation), d(phi_i), d(phi_j)] drive the incremental internal
+    * forces through the local stiffness [EA/L; 4EI/L 2EI/L; 2EI/L 4EI/L].
+    * Accumulated internal forces force_ = [N, Mi, Mj] are rotated to the
+    * current axis triad (exa_, eya_) and applied to the particles as
+    * restoring forces. Shear V = (Mi + Mj) / lt follows from moment
+    * equilibrium in the current configuration.
+    * Sign conventions: N > 0 tension; Mi/Mj counter-clockwise positive
+    * internal end moments; V positive along +eya at end i.
+    */
+    protected:
+        const StdArray6d* curr_posi_;
+        const StdArray6d* curr_posj_;
+        const StdArray6d* prev_posi_;
+        const StdArray6d* prev_posj_;
+
+        // configuration at the previous internal-force update; kept by the
+        // element itself so the fictitious previous position generated by
+        // Particle::solveFirstStep never enters the deformation increments
+        StdArray6d last_posi_;
+        StdArray6d last_posj_;
+
+        Eigen::Matrix3d stiffness_;
+        Eigen::Vector3d force_;
+
+        ElementForce emfi_, emfj_;
+        Eigen::Vector3d exa_, eya_, eza_;
+        double elem_rotation_angle_;
+
+        inline void initiateStiffnessMatrix();
+        virtual void setParticleDof();
+        virtual void setParticleMass();
+        virtual void calcOrientVector();
+        virtual void calcElementForce();
+
+    public:
+        Beam2D(int id, Particle& pi, Particle& pj, const BaseMaterial& mat,
+               const BaseSection& sect);
+        ~Beam2D() override = default;
+        [[nodiscard]] const ElementForce& end_force_i() const noexcept;
+        [[nodiscard]] const ElementForce& end_force_j() const noexcept;
+        double rotation_angle() const;
+        virtual double calcCriticalTimeStep();
+        virtual void outputForce(std::fstream &fout);
+        virtual void outputStress(std::fstream &fout);
+        virtual void outputStrain(std::fstream &fout);
+};
+
+class Beam3D:public StructElement
+{
+    /* Elastic 3D Beam element, which can count on geometric nonlinearity
+    * Only Elastic materials are supported, if an plasticity material is given
+    * only the elastic state will be used. Obviously this element do not
+    * support the failure of element.
+    *
+    * Formulation (VFIFE co-rotational, generalised from Beam2D): the element
+    * carries an orthonormal section triad (exa_, eya_, eza_) as state, since
+    * unlike Beam2D there is no fixed global axis it can be rebuilt from each
+    * step. Each step the rigid chord rotation and the rigid twist between
+    * the last recorded configuration and the current one are removed; the
+    * remaining deformational rotation increments drive two independent
+    * bending planes that reuse the validated Beam2D [4,2;2,4] recipe:
+    *   plane 1: (ex, ey), bending about ez, stiffness EIzz -> mz_i_/mz_j_
+    *   plane 2: (ex, ez), bending about -ey, stiffness EIyy -> mb_i_/mb_j_
+    * plus an axial force n_force_ (EA/L) and a torsion t_moment_ (GJ/L)
+    * about ex. Accumulated forces are rotated into the current triad and
+    * applied to the particles as restoring forces, mirroring Beam2D.
+    * Sign conventions: N > 0 tension; T > 0 about +ex; Mz/Mb end moments
+    * follow the same convention as Beam2D's Mi/Mj in their own plane.
+    */
+    protected:
+        StdArray3d reference_node_;
+        const StdArray6d* curr_posi_;
+        const StdArray6d* curr_posj_;
+        const StdArray6d* prev_posi_;
+        const StdArray6d* prev_posj_;
+
+        // configuration (position + rotation, indices 0-2 / 3-5) at the
+        // previous internal-force update; same role as Beam2D's last_posi_
+        StdArray6d last_posi_;
+        StdArray6d last_posj_;
+
+        // current orthonormal section triad, carried as state (see class
+        // comment above)
+        Eigen::Vector3d exa_, eya_, eza_;
+
+        // This element's contribution to each end particle's rotational
+        // inertia matrix.  The legacy 3D-frame oracle stores principal
+        // inertias in the element basis and reprojects them after the basis
+        // rotates; keeping the last contribution lets us update shared-node
+        // particle inertia by delta without clearing other elements.
+        Eigen::Matrix3d rotational_mass_contribution_;
+
+        // accumulated internal forces: axial N, torsion T about ex, and end
+        // moments of the two independent bending planes
+        double n_force_, t_moment_;
+        double mz_i_, mz_j_;
+        double mb_i_, mb_j_;
+
+        // local incremental stiffness terms.  They are refreshed with the
+        // current/deformed length before each force update, matching frm3D.
+        double ka_;                   // E*A/Lcurrent
+        double kt_;                   // G*J/Lcurrent
+        Eigen::Matrix2d kb1_, kb2_;    // (E*I/Lcurrent)*[[4,2],[2,4]]
+
+        ElementForce emfi_, emfj_;
+
+        inline void initiateBeam3D();
+
+        virtual void setParticleDof();
+        virtual void setParticleMass();
+        virtual void calcOrientVector();
+        virtual void calcElementForce();
+
+    public:
+        // create spatial Beam with default reference node (0, 0, 1)
+        Beam3D(int id, Particle& pi, Particle& pj, const BaseMaterial& mat,
+               const BaseSection& sect);
+        // create spatial Beam with giving reference node
+        Beam3D(int id, Particle& pi, Particle& pj, const BaseMaterial& mat,
+               const BaseSection& sect, const StdArray3d ref_node);
+        ~Beam3D() override = default;
+        [[nodiscard]] const ElementForce& end_force_i() const noexcept;
+        [[nodiscard]] const ElementForce& end_force_j() const noexcept;
+        virtual double calcCriticalTimeStep();
+        virtual void outputForce(std::fstream &fout);
+        virtual void outputStress(std::fstream &fout);
+        virtual void outputStrain(std::fstream &fout);
+};
+
+} // namespace openvfife
